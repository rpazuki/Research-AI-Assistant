# ─────────────────────────────────────────────────────────────────────────────
#  Addresses for the `compose` scenario: containers on a dev machine.
#  Loaded ONLY by docker-compose.yml (env_file), never sourced into a shell.
#  Committed: contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

RLALAB_ENV=compose

# Inside the Compose network Postgres is `db` on its own port 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/rlalab_ai

# Browser-facing origins. The browser is outside the network, so these are
# localhost even though the services talk to each other by service name.
CORS_ORIGINS='["http://localhost:3000"]'
APP_PUBLIC_URL=http://localhost:3000
