# ─────────────────────────────────────────────────────────────────────────────
#  TEMPLATE — copy to .env and fill in the secrets.
#  Secrets and behaviour. Shared by EVERY scenario (local, compose, server).
#
#  RULE: no hostnames, no ports, no URLs pointing at our own services.
#  Addresses live in .env.compose / .env.server and are loaded only by Compose;
#  the `local` scenario uses the code defaults. That is what makes this file safe
#  to `source` in any shell — see run_and_deploy.md §2.
# ─────────────────────────────────────────────────────────────────────────────

# ── Scenario ─────────────────────────────────────────────────────────────────
# local | compose | server.  Leave as `local` here: Compose overrides it.
RLALAB_ENV=local

# ── Database credentials (the address is NOT here) ───────────────────────────
POSTGRES_DB=rlalab_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY='<64-hex-chars: python -c "import secrets; print(secrets.token_hex(32))">'
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITATION_TOKEN_EXPIRE_HOURS=168
FRONTEND_HOST_PORT=3000
# FRONTEND_AUTH_COOKIE_SECURE=false

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY='<your-anthropic-api-key>'

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=pubmedbert
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./model_cache

# ── NCBI / PubMed ────────────────────────────────────────────────────────────
NCBI_EMAIL='<you>@imperial.ac.uk'
NCBI_API_KEY='<your-ncbi-api-key>'

# ── Acquisition (datasheet feature, S3) ───────────────────────────────────────
# Contact addresses, not secrets. Unpaywall requires one; Crossref and OpenAlex
# use theirs for the polite pool. Each falls back to NCBI_EMAIL when empty.
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
# LibKey/EZproxy link pattern containing {doi}, for assisted acquisition links.
# Empty falls back to https://doi.org/{doi}. Never used for a scripted login.
LIBKEY_RESOLVER_TEMPLATE=
EZPROXY_URL_TEMPLATE=
# Publisher text-and-data-mining key. The route is implemented but inert without it.
ELSEVIER_TDM_KEY=
NCBI_SLEEP_BETWEEN_BATCHES_S=0.15

# ── Extraction (datasheet feature, S5) ────────────────────────────────────────
# Off by default. Extraction is the only phase that sends paper text to Anthropic
# and the only one that costs money. With this false a run still reaches phase D:
# it counts tokens, reports projected cost, and stops. Turn it on deliberately.
DATASHEET_EXTRACTION_ENABLED=false
# Sonnet 5 does the bulk pass; Opus 5 revisits only the cells Sonnet was unsure
# about, capped at 10% of cells so a bad batch cannot multiply the bill.
DATASHEET_EXTRACTION_MODEL=claude-sonnet-5
DATASHEET_ESCALATION_MODEL=claude-opus-5
DATASHEET_ESCALATION_ENABLED=true
DATASHEET_ESCALATION_CONFIDENCE=0.6
DATASHEET_ESCALATION_MAX_FRACTION=0.10
# Batch API: half price, usually under an hour. Extraction is not latency-sensitive.
# A submitted batch parks its run (status `awaiting_batch`) rather than being waited
# on in the worker — the same process serves the ingestion queue, and a 24-hour wait
# inside a job would stall it. The interval below therefore does double duty: it is
# how often a parked run is re-claimed to poll its batch, so lowering it means more
# calls to the batch endpoint, not faster extraction.
DATASHEET_USE_BATCH_API=true
DATASHEET_BATCH_POLL_INTERVAL_S=60
# Outlier backstop, not the normal path: S4 measured a median of 8,350 tokens of
# selected sections per paper.
DATASHEET_MAX_SECTION_TOKENS=24000
DATASHEET_MAX_PAPERS_PER_RUN=1000

# ── RAG parameters ───────────────────────────────────────────────────────────
RETRIEVAL_VECTOR_TOP_K=10
RETRIEVAL_LEXICAL_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Email / SendGrid ─────────────────────────────────────────────────────────
SENDGRID_API_KEY='<your-sendgrid-api-key>'
SENDGRID_FROM_EMAIL='<sender>@imperial.ac.uk'
SENDGRID_FROM_NAME='RLALab AI Assistant'
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
SENDGRID_TIMEOUT_S=30
