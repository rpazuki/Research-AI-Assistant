# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rlalab_ai

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=pubmedbert
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./model_cache

# ── NCBI / PubMed ─────────────────────────────────────────────────────────────
NCBI_EMAIL=your_email@imperial.ac.uk
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_SLEEP_BETWEEN_BATCHES_S=0.15

# ── RAG parameters ────────────────────────────────────────────────────────────
RETRIEVAL_VECTOR_TOP_K=10
RETRIEVAL_LEXICAL_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── App ───────────────────────────────────────────────────────────────────────
# Defaults live in backend/configs/backend.yaml, frontend/configs/frontend.yaml,
# and evaluation/configs/evaluation.yaml. Environment variables override YAML.
APP_ENV=development
FRONTEND_ENV=development
EVALUATION_ENV=development
PIPELINE_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PROXY_PREFIX=/api/backend

# ── Email / SendGrid ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=RLALab AI Assistant
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
SENDGRID_TIMEOUT_S=30
INVITATION_TOKEN_EXPIRE_HOURS=168
