# ─────────────────────────────────────────────────────────────────────────────
#  Addresses for the `server` scenario: containers on the deployment VM.
#  Loaded ONLY by docker-compose.prod.yml (env_file), never sourced into a shell.
#  Committed: contains no secrets. Set the real hostname below before deploying.
# ─────────────────────────────────────────────────────────────────────────────

RLALAB_ENV=server

# DATABASE_URL is deliberately NOT here. It is assembled in docker-compose.prod.yml
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, so the password has exactly
# one owner (.env). Written here it would be a second copy that drifts the moment
# anyone rotates the password — which is what put the stack in a restart loop.
# Compose can do that because ${VAR} in a compose file is interpolated from .env;
# inside an env_file like this one it would not be.

# Postgres is deliberately not published on the VM. Reach it with
#   docker compose -f docker-compose.prod.yml exec db psql -U postgres -d rlalab_ai

# The public origin, terminated by nginx. Must be the real hostname, not localhost.
CORS_ORIGINS='["https://assistant.rlalab.imperial.ac.uk"]'
APP_PUBLIC_URL=https://assistant.rlalab.imperial.ac.uk
